{
  "manifest_version": 3,
  "name": "Traducteur d'écran",
  "version": "1.6",
  "description": "Traduit les pages directement dans la page, avec le Traducteur d'écran installé sur ton PC (hors ligne).",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_title": "Traducteur d'écran",
    "default_popup": "fenetre.html",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  },
  "background": {
    "service_worker": "fond.js",
    "scripts": ["fond.js"]
  },
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": ["http://127.0.0.1:47115/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
